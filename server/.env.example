# Which provider the agents use by default: gemini | qwen | mistral | kimi | llama
# (a job can override it)
PROVIDER=gemini

# Gemini (Google AI Studio key). Set an exact model ID you have tested.
GOOGLE_API_KEY=
GEMINI_MODEL=

# Qwen via its OpenAI-compatible endpoint. QWEN_MODEL must accept images (A2 diagrams, A1 table layouts).
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=

# Each provider uses one *_MODEL for every agent, including image prompts (as with Gemini), so
# pick a model that accepts images.

# Mistral via @langchain/mistralai (ChatMistralAI). Base URL is optional.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL=

# Kimi (Moonshot AI) via ChatOpenAI against its OpenAI-compatible endpoint
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=

# Llama via ChatOpenAI against Meta's Llama API; any OpenAI-compatible Llama host (Groq, Together, OpenRouter) also works
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1
LLAMA_MODEL=

# Express server port
PORT=4000

# Copilot Chat (copy & paste) only: longest prompt to paste. Longer prompts are shrunk (default-valued
# and bookkeeping fields left out) to fit. Copilot work tier allows 128,000; 120000 leaves some margin.
# CHAT_PROMPT_MAX_CHARS=120000
