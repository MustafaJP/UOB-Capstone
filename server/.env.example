# Which provider the agents use by default: gemini | qwen (a job can override it)
PROVIDER=gemini

# Gemini (Google AI Studio key). Set an exact model ID you have tested.
GOOGLE_API_KEY=
GEMINI_MODEL=

# Qwen via its OpenAI-compatible endpoint. A2 (diagram) needs a vision-capable model.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
QWEN_VISION_MODEL=

# Express server port
PORT=4000
