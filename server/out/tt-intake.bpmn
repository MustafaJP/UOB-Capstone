  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_bo" name="Branch Officer">
        <bpmn:flowNodeRef>N_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_c9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ro" name="Remittance Operations">
        <bpmn:flowNodeRef>N_c2</bpmn:flowNodeRef>
