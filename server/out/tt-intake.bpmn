      </bpmn:lane>
      <bpmn:lane id="L_treasury" name="Treasury">
        <bpmn:flowNodeRef>N_c13</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_start" name="Start application intake">
      <bpmn:documentation>evidence: E2; origin: inferred</bpmn:documentation>
      <bpmn:outgoing>F_r0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="N_c1" name="Receive and stamp TT application">
      <bpmn:documentation>evidence: E2; origin: source_extracted</bpmn:documentation>
      <bpmn:incoming>F_r0</bpmn:incoming>
      <bpmn:outgoing>F_r1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="N_c2" name="Check original TT application">
      <bpmn:documentation>evidence: E3; origin: source_extracted</bpmn:documentation>
      <bpmn:incoming>F_r1</bpmn:incoming>
      <bpmn:incoming>F_r9</bpmn:incoming>
      <bpmn:outgoing>F_r2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="N_c5" name="Check if application contains alterations">
      <bpmn:documentation>evidence: E4; origin: inferred</bpmn:documentation>
      <bpmn:incoming>F_r2</bpmn:incoming>
      <bpmn:outgoing>F_r3</bpmn:outgoing>
      <bpmn:outgoing>F_r4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="N_c6" name="Check alteration countersignatures">
      <bpmn:documentation>evidence: E4; origin: source_extracted</bpmn:documentation>
      <bpmn:incoming>F_r3</bpmn:incoming>
      <bpmn:outgoing>F_r5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="N_c7" name="Check if each alteration is countersigned">
      <bpmn:documentation>evidence: E4; origin: inferred</bpmn:documentation>
      <bpmn:incoming>F_r5</bpmn:incoming>
      <bpmn:outgoing>F_r6</bpmn:outgoing>
      <bpmn:outgoing>F_r7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="N_c8" name="Return application to Branch Officer">
      <bpmn:documentation>evidence: E4; origin: source_extracted</bpmn:documentation>
      <bpmn:incoming>F_r7</bpmn:incoming>
      <bpmn:outgoing>F_r8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="N_c9" name="Contact customer to submit corrected application">
      <bpmn:documentation>evidence: E4; origin: source_extracted</bpmn:documentation>
      <bpmn:incoming>F_r8</bpmn:incoming>
      <bpmn:outgoing>F_r9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="N_c10" name="Check if payment currency differs from debit account currency and amount is above SGD 50,000 equivalent">
      <bpmn:documentation>evidence: E5; origin: inferred</bpmn:documentation>
      <bpmn:incoming>F_r4</bpmn:incoming>
      <bpmn:incoming>F_r6</bpmn:incoming>
      <bpmn:outgoing>F_r10</bpmn:outgoing>
      <bpmn:outgoing>F_r11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="N_c11" name="Check if FX contract number is captured">
      <bpmn:documentation>evidence: E5; origin: inferred</bpmn:documentation>
      <bpmn:incoming>F_r10</bpmn:incoming>
      <bpmn:outgoing>F_r12</bpmn:outgoing>
      <bpmn:outgoing>F_r13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="N_c12" name="Place application on hold">
      <bpmn:documentation>evidence: E5; origin: source_extracted</bpmn:documentation>
      <bpmn:incoming>F_r13</bpmn:incoming>
      <bpmn:outgoing>F_r14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="N_c13" name="Confirm booking">
      <bpmn:documentation>evidence: E5; origin: source_extracted</bpmn:documentation>
      <bpmn:incoming>F_r14</bpmn:incoming>
      <bpmn:outgoing>F_r15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="N_c14" name="Pass application to payment processing queue">
      <bpmn:documentation>evidence: E6; origin: source_extracted</bpmn:documentation>
      <bpmn:incoming>F_r11</bpmn:incoming>
      <bpmn:incoming>F_r12</bpmn:incoming>
      <bpmn:incoming>F_r15</bpmn:incoming>
      <bpmn:outgoing>F_r16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="N_c16" name="End application intake">
      <bpmn:documentation>evidence: E6; origin: inferred</bpmn:documentation>
      <bpmn:incoming>F_r16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_r0" sourceRef="N_start" targetRef="N_c1" />
