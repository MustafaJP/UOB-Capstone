    <bpmn:textAnnotation id="A_c3">
      <bpmn:text>Note: Instructions must be complete: beneficiary name, beneficiary account number, beneficiary bank SWIFT code, amount and currency.</bpmn:text>
    </bpmn:textAnnotation>
