    <bpmn:sequenceFlow id="F_r9" sourceRef="N_c9" targetRef="N_c2" name="Corrected application submitted" />
    <bpmn:sequenceFlow id="F_r10" sourceRef="N_c10" targetRef="N_c11" name="Payment currency differs and amount is above SGD 50,000 equivalent" />
    <bpmn:sequenceFlow id="F_r11" sourceRef="N_c10" targetRef="N_c14" name="Payment currency does not differ or amount is not above SGD 50,000 equivalent" />
    <bpmn:sequenceFlow id="F_r12" sourceRef="N_c11" targetRef="N_c14" name="FX contract number is provided" />
    <bpmn:sequenceFlow id="F_r13" sourceRef="N_c11" targetRef="N_c12" name="No FX contract number is provided" />
    <bpmn:sequenceFlow id="F_r14" sourceRef="N_c12" targetRef="N_c13" />
    <bpmn:sequenceFlow id="F_r15" sourceRef="N_c13" targetRef="N_c14" name="Booking confirmed" />
